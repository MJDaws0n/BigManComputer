// ---------------------------------------------------------------------------
// hash - SHA-256 password hashing (NIST FIPS 180-4)
// Uses single SHA-256 calls (no key stretching) to avoid heap exhaustion
// in forked processes. Novus has no GC so repeated array allocations corrupt.
// ---------------------------------------------------------------------------

module hash;

import ../lib/std/main;

fn to_i64(v: i32) -> i64 { return u64_to_i64(i32_to_u64(v)); }
fn m32(v: i64) -> i64 { return v & 4294967295; }
fn rotr32(x: i64, n: i64) -> i64 { return m32((x >> n) | (x << (32 - n))); }
fn sha_ch(x: i64, y: i64, z: i64) -> i64 { return m32((x & y) ^ (m32(~x) & z)); }
fn sha_maj(x: i64, y: i64, z: i64) -> i64 { return m32((x & y) ^ (x & z) ^ (y & z)); }
fn sha_s0(x: i64) -> i64 { return m32(rotr32(x, 2) ^ rotr32(x, 13) ^ rotr32(x, 22)); }
fn sha_s1(x: i64) -> i64 { return m32(rotr32(x, 6) ^ rotr32(x, 11) ^ rotr32(x, 25)); }
fn sha_ls0(x: i64) -> i64 { return m32(rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3)); }
fn sha_ls1(x: i64) -> i64 { return m32(rotr32(x, 17) ^ rotr32(x, 19) ^ (x >> 10)); }

fn sha256_k(i: i32) -> i64 {
    if (i == 0) { return 1116352408; } if (i == 1) { return 1899447441; }
    if (i == 2) { return 3049323471; } if (i == 3) { return 3921009573; }
    if (i == 4) { return 961987163; } if (i == 5) { return 1508970993; }
    if (i == 6) { return 2453635748; } if (i == 7) { return 2870763221; }
    if (i == 8) { return 3624381080; } if (i == 9) { return 310598401; }
    if (i == 10) { return 607225278; } if (i == 11) { return 1426881987; }
    if (i == 12) { return 1925078388; } if (i == 13) { return 2162078206; }
    if (i == 14) { return 2614888103; } if (i == 15) { return 3248222580; }
    if (i == 16) { return 3835390401; } if (i == 17) { return 4022224774; }
    if (i == 18) { return 264347078; } if (i == 19) { return 604807628; }
    if (i == 20) { return 770255983; } if (i == 21) { return 1249150122; }
    if (i == 22) { return 1555081692; } if (i == 23) { return 1996064986; }
    if (i == 24) { return 2554220882; } if (i == 25) { return 2821834349; }
    if (i == 26) { return 2952996808; } if (i == 27) { return 3210313671; }
    if (i == 28) { return 3336571891; } if (i == 29) { return 3584528711; }
    if (i == 30) { return 113926993; } if (i == 31) { return 338241895; }
    if (i == 32) { return 666307205; } if (i == 33) { return 773529912; }
    if (i == 34) { return 1294757372; } if (i == 35) { return 1396182291; }
    if (i == 36) { return 1695183700; } if (i == 37) { return 1986661051; }
    if (i == 38) { return 2177026350; } if (i == 39) { return 2456956037; }
    if (i == 40) { return 2730485921; } if (i == 41) { return 2820302411; }
    if (i == 42) { return 3259730800; } if (i == 43) { return 3345764771; }
    if (i == 44) { return 3516065817; } if (i == 45) { return 3600352804; }
    if (i == 46) { return 4094571909; } if (i == 47) { return 275423344; }
    if (i == 48) { return 430227734; } if (i == 49) { return 506948616; }
    if (i == 50) { return 659060556; } if (i == 51) { return 883997877; }
    if (i == 52) { return 958139571; } if (i == 53) { return 1322822218; }
    if (i == 54) { return 1537002063; } if (i == 55) { return 1747873779; }
    if (i == 56) { return 1955562222; } if (i == 57) { return 2024104815; }
    if (i == 58) { return 2227730452; } if (i == 59) { return 2361852424; }
    if (i == 60) { return 2428436474; } if (i == 61) { return 2756734187; }
    if (i == 62) { return 3204031479; } if (i == 63) { return 3329325298; }
    return 0;
}

fn hex_nibble(v: i64) -> str {
    if (v == 0) { return "0"; } if (v == 1) { return "1"; }
    if (v == 2) { return "2"; } if (v == 3) { return "3"; }
    if (v == 4) { return "4"; } if (v == 5) { return "5"; }
    if (v == 6) { return "6"; } if (v == 7) { return "7"; }
    if (v == 8) { return "8"; } if (v == 9) { return "9"; }
    if (v == 10) { return "a"; } if (v == 11) { return "b"; }
    if (v == 12) { return "c"; } if (v == 13) { return "d"; }
    if (v == 14) { return "e"; } if (v == 15) { return "f"; }
    return "0";
}

fn hex8(val: i64) -> str {
    let v: i64 = m32(val);
    return hex_nibble((v >> 28) & 15) + hex_nibble((v >> 24) & 15) +
           hex_nibble((v >> 20) & 15) + hex_nibble((v >> 16) & 15) +
           hex_nibble((v >> 12) & 15) + hex_nibble((v >> 8) & 15) +
           hex_nibble((v >> 4) & 15) + hex_nibble(v & 15);
}

// ---------------------------------------------------------------------------
// SHA-256 hash - NIST FIPS 180-4 compliant
// ---------------------------------------------------------------------------

fn sha256(msg: str) -> str {
    let msg_len: i32 = len(msg);
    let bit_len: i64 = to_i64(msg_len) * 8;

    let pad_len: i32 = 64 - ((msg_len + 9) % 64);
    if (pad_len == 64) { pad_len = 0; }
    let total: i32 = msg_len + 1 + pad_len + 8;

    let buf: []i64 = [];
    let i: i32 = 0;
    while (i < msg_len) {
        array_append(buf, to_i64(byte_at(msg, i)));
        i = i + 1;
    }
    array_append(buf, 128);
    i = msg_len + 1;
    while (i < total - 8) { array_append(buf, 0); i = i + 1; }
    array_append(buf, (bit_len >> 56) & 255);
    array_append(buf, (bit_len >> 48) & 255);
    array_append(buf, (bit_len >> 40) & 255);
    array_append(buf, (bit_len >> 32) & 255);
    array_append(buf, (bit_len >> 24) & 255);
    array_append(buf, (bit_len >> 16) & 255);
    array_append(buf, (bit_len >> 8) & 255);
    array_append(buf, bit_len & 255);

    let h0: i64 = 1779033703; let h1: i64 = 3144134277;
    let h2: i64 = 1013904242; let h3: i64 = 2773480762;
    let h4: i64 = 1359893119; let h5: i64 = 2600822924;
    let h6: i64 = 528734635; let h7: i64 = 1541459225;

    let block: i32 = 0;
    while (block < total) {
        let w: []i64 = [];
        let t: i32 = 0;
        while (t < 16) {
            let base: i32 = block + t * 4;
            let val: i64 = (buf[base] << 24) | (buf[base + 1] << 16) |
                           (buf[base + 2] << 8) | buf[base + 3];
            array_append(w, m32(val));
            t = t + 1;
        }
        while (t < 64) {
            let wt: i64 = m32(w[t - 16] + sha_ls0(w[t - 15]) + w[t - 7] + sha_ls1(w[t - 2]));
            array_append(w, wt);
            t = t + 1;
        }
        let a: i64 = h0; let b: i64 = h1; let c: i64 = h2; let d: i64 = h3;
        let e: i64 = h4; let f: i64 = h5; let g: i64 = h6; let hv: i64 = h7;
        t = 0;
        while (t < 64) {
            let t1: i64 = m32(hv + sha_s1(e) + sha_ch(e, f, g) + sha256_k(t) + w[t]);
            let t2: i64 = m32(sha_s0(a) + sha_maj(a, b, c));
            hv = g; g = f; f = e; e = m32(d + t1);
            d = c; c = b; b = a; a = m32(t1 + t2);
            t = t + 1;
        }
        h0 = m32(h0 + a); h1 = m32(h1 + b); h2 = m32(h2 + c); h3 = m32(h3 + d);
        h4 = m32(h4 + e); h5 = m32(h5 + f); h6 = m32(h6 + g); h7 = m32(h7 + hv);
        block = block + 64;
    }
    return hex8(h0) + hex8(h1) + hex8(h2) + hex8(h3) +
           hex8(h4) + hex8(h5) + hex8(h6) + hex8(h7);
}

// ---------------------------------------------------------------------------
// Generate a salt from username (deterministic but unique per user)
// ---------------------------------------------------------------------------

fn make_salt(username: str) -> str {
    let hval: str = sha256("bmc_salt_" + username + "_pepper_2024");
    return substr_len(hval, 0, 16);
}

// ---------------------------------------------------------------------------
// Hash password: SHA-256(salt + pepper + password)
// Single call to avoid heap exhaustion from array allocations in Novus
// ---------------------------------------------------------------------------

fn hash_password(password: str, salt: str) -> str {
    return sha256(salt + ":bmc_pepper_2024:" + password);
}

// ---------------------------------------------------------------------------
// Verify a password against a stored hash
// ---------------------------------------------------------------------------

fn verify_password(password: str, salt: str, stored_hash: str) -> bool {
    let computed: str = hash_password(password, salt);
    return computed == stored_hash;
}

// ---------------------------------------------------------------------------
// Generate a session token from username + timestamp
// ---------------------------------------------------------------------------

fn generate_session_token(username: str, timestamp: str) -> str {
    return sha256(username + ":" + timestamp + ":bmc_session_secret_2024");
}
